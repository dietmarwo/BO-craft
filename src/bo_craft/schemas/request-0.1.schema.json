{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-craft:request:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bo.request/0.1"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bo.problem/0.1"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "type": {
                "enum": [
                  "continuous",
                  "integer",
                  "categorical"
                ]
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "log": {
                "type": "boolean"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "active_if": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              }
            },
            "required": [
              "name",
              "type"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "direction": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "name",
              "direction"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "name"
            ]
          },
          "minItems": 0,
          "maxItems": 16
        },
        "input_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coefficients": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "maxProperties": 32
              },
              "upper": {
                "type": "number"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "coefficients",
              "upper"
            ]
          },
          "minItems": 0,
          "maxItems": 64
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "target": {
              "type": "number"
            },
            "cost_intercept": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cost_weight": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "parameter",
            "target",
            "cost_intercept",
            "cost_weight"
          ]
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "id",
            "version"
          ]
        }
      },
      "required": [
        "schema_version",
        "parameters",
        "objectives"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "trial_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "x": {
            "type": "object",
            "maxProperties": 128,
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "pruned",
              "cancelled",
              "unknown"
            ]
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "maxProperties": 32
          },
          "variances": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "variance_kind": {
            "enum": [
              "mean"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "replicate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 1000000
          },
          "provenance": {
            "type": "object"
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "intermediate": {
            "type": "object",
            "maxProperties": 10000,
            "propertyNames": {
              "pattern": "^(0|[1-9][0-9]{0,8})$"
            },
            "additionalProperties": {
              "type": "number"
            },
            "description": "Learning curve of the objective: step -> value; for pruned and completed observations of a single objective"
          }
        },
        "required": [
          "id",
          "trial_id",
          "x",
          "status"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "x": {
            "type": "object",
            "maxProperties": 128,
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        },
        "required": [
          "id",
          "x"
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "botorch",
            "optuna",
            "random",
            "vizier",
            "bo-mcp"
          ]
        },
        "noise": {
          "enum": [
            "known",
            "inferred",
            "deterministic"
          ]
        },
        "initial_points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1024
        },
        "fit_maxiter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "num_restarts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "raw_samples": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "mc_samples": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "training_cap": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1024
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "reference_point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "acquisition": {
          "enum": [
            "log_nei",
            "log_nehvi",
            "multifidelity_kg"
          ]
        },
        "multivariate": {
          "type": "boolean"
        },
        "group": {
          "type": "boolean"
        },
        "constant_liar": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "study": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "backend": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            }
          },
          "required": [
            "endpoint",
            "study"
          ]
        },
        "acq_maxiter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "outcome_transform": {
          "enum": [
            "standardize",
            "log",
            "bilog"
          ]
        },
        "feasibility_probability": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.999
        },
        "replication": {
          "enum": [
            "none",
            "incumbent"
          ]
        },
        "replication_threshold": {
          "type": "number",
          "minimum": 0.05,
          "exclusiveMaximum": 1
        },
        "max_replicates": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "trust_region": {
          "type": "boolean"
        },
        "num_fantasies": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        },
        "sampler": {
          "enum": [
            "tpe",
            "gp"
          ]
        },
        "pruned": {
          "enum": [
            "ignore",
            "last"
          ]
        }
      },
      "required": [
        "backend"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  },
  "required": [
    "schema_version",
    "problem",
    "config",
    "seed",
    "q"
  ]
}
