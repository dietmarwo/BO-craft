{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-craft:problem:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bo.problem/0.1"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "type": {
            "enum": [
              "continuous",
              "integer",
              "categorical"
            ]
          },
          "lower": {
            "type": "number"
          },
          "upper": {
            "type": "number"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "log": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "active_if": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "minItems": 1,
              "maxItems": 1000
            }
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "direction": {
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "name",
          "direction"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "name"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    },
    "input_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "coefficients": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "maxProperties": 32
          },
          "upper": {
            "type": "number"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "coefficients",
          "upper"
        ]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target": {
          "type": "number"
        },
        "cost_intercept": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost_weight": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "parameter",
        "target",
        "cost_intercept",
        "cost_weight"
      ]
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "id",
        "version"
      ]
    }
  },
  "required": [
    "schema_version",
    "parameters",
    "objectives"
  ]
}
