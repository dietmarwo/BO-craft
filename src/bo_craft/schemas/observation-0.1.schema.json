{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-craft:observation:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "trial_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "x": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "pruned",
        "cancelled",
        "unknown"
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 32
    },
    "variances": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "variance_kind": {
      "enum": [
        "mean"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "replicate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "provenance": {
      "type": "object"
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "intermediate": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "additionalProperties": {
        "type": "number"
      },
      "description": "Learning curve of the objective: step -> value; for pruned and completed observations of a single objective"
    }
  },
  "required": [
    "id",
    "trial_id",
    "x",
    "status"
  ]
}
