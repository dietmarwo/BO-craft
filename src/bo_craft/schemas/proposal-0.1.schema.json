{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-craft:proposal:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bo.proposal/0.1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "problem_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "maxProperties": 128,
        "additionalProperties": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "minItems": 1,
      "maxItems": 32
    },
    "diagnostics": {
      "type": "object"
    },
    "replicate_of": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "request_sha256",
    "problem_sha256",
    "candidates",
    "diagnostics"
  ]
}
